# Event Nu backend — configuration template
# Copy to `.env` and adjust. The committed `.env.example` contains NO secrets.
# Variables without a comment fall back to the shown default when unset.

# --- Runtime -------------------------------------------------------------
APP_ENV=development            # development | production
PORT=8080
API_PUBLIC_BASE=http://localhost:8080

# --- Database ------------------------------------------------------------
# app_user runs under RLS; the owner URL is used only for migrations/admin.
DATABASE_URL=postgres://app_user:app_user_pass@127.0.0.1:55432/event_nu_test?sslmode=disable
DATABASE_ADMIN_URL=postgres://postgres:postgres@127.0.0.1:55432/event_nu_test?sslmode=disable

# --- Security / sessions -------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
TICKET_QR_SECRET=change-me-too
JWT_EXPIRY=15m                 # access token lifetime
REFRESH_TOKEN_EXPIRY=30d       # refresh token lifetime

# --- CORS ----------------------------------------------------------------
CORS_ALLOWED_ORIGINS=          # comma-separated list (empty = not restricted)

# --- Email ---------------------------------------------------------------
# noop for local dev (emails are mocked). brevo requires all BREVO_* vars and
# an activated SMTP relay (currently returns 403 until enabled). noop is safe.
EMAIL_PROVIDER=noop
BREVO_API_BASE=https://api.brevo.com/v3
BREVO_API_KEY=
BREVO_API_SENDER=
BREVO_SENDER_EMAIL=event.nua@gmail.com
BREVO_SENDER_NAME=Event Nu
BREVO_TEMPLATE_WELCOME=0
BREVO_TEMPLATE_VERIFY=0
EMAIL_POLL_INTERVAL=2s
EMAIL_BATCH_SIZE=20
EMAIL_MAX_ATTEMPTS=3
EMAIL_RETRY_BASE_DELAY=30s

# --- Rate limits (per account/IP window) --------------------------------
AUTH_REGISTER_RATE_LIMIT=10
AUTH_REGISTER_RATE_WINDOW=1h
AUTH_LOGIN_RATE_LIMIT=5
AUTH_LOGIN_RATE_WINDOW=10m
AUTH_REFRESH_RATE_LIMIT=30
AUTH_REFRESH_RATE_WINDOW=10m
AUTH_VERIFY_RATE_LIMIT=20
AUTH_VERIFY_RATE_WINDOW=1h

# --- Media storage -------------------------------------------------------
MEDIA_STORAGE_PROVIDER=local    # local | s3
MEDIA_LOCAL_DIR=./media-store
MEDIA_PUBLIC_BASE=http://localhost:8080/media
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=
MEDIA_S3_BUCKET=
MEDIA_S3_ACCESS_KEY=
MEDIA_S3_SECRET_KEY=
MEDIA_MAX_UPLOAD_BYTES=10485760
MEDIA_UPLOAD_EXPIRY=15m
MEDIA_JOB_POLL_INTERVAL=2s
MEDIA_JOB_BATCH_SIZE=10
MEDIA_JOB_MAX_ATTEMPTS=3
MEDIA_JOB_RETRY_BASE_DELAY=30s

# --- Payments ------------------------------------------------------------
PAYMENT_PROVIDER=noop           # noop | chapa
CHAPA_API_BASE=https://api.chapa.co/v1
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
CHAPA_REDIRECT_BASE=http://localhost:8080

# --- Push notifications --------------------------------------------------
PUSH_PROVIDER=noop              # noop | fcm
FCM_SERVICE_ACCOUNT=
FCM_PROJECT_ID=
FCM_API_BASE=https://fcm.googleapis.com/v1
FCM_TOKEN_URL=https://oauth2.googleapis.com/token
PUSH_POLL_INTERVAL=2s
PUSH_BATCH_SIZE=50
PUSH_MAX_ATTEMPTS=5
PUSH_RETRY_BASE_DELAY=30s

# --- Sync / misc ---------------------------------------------------------
SYNC_MAX_LIMIT=500