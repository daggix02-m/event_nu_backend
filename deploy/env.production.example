# Event Nu backend — production environment template.
# Copy to deploy/.env, fill in real values, and: chmod 600 deploy/.env
# (compose auto-loads .env from this directory format).
# NEVER commit the filled file; the root .gitignore already excludes it.
#
# Secrets live in the Vault KV record secret/eventnu — NOT in this file.
# This template carries only Vault credentials and non-secret configuration.
# Any variable that IS set here still wins over Vault (documented
# precedence), so a commented-out secret below acts as an emergency
# override, not a second store. config.Load() aborts at boot if Vault is
# unreachable AND a value is missing from the environment.

# --- Runtime ----------------------------------------------------------
APP_ENV=production
PORT=8080
API_PUBLIC_BASE=https://EVENTS.EXAMPLE.COM

# --- Docker image -----------------------------------------------------
# Pin one immutable tag; the runbook rotates it for upgrades/rollbacks.
IMAGE=eventnu:latest

# --- Vault ------------------------------------------------------------
# Address/mount/path are also set by docker-compose.prod.yml for the app
# services; they are repeated here so local verification against the
# production setup uses the same values. Only the credentials are truly
# needed in .env.
#VAULT_ADDR=http://vault:8200
#VAULT_KV_MOUNT=secret
#VAULT_KV_PATH=eventnu
VAULT_ROLE_ID=<from "vault read auth/approle/role/eventnu/role-id" — runbook>
# Prefer the file form (compose secret bind, 0600) over the plain value:
# mount a single-use secret id at /run/secrets/vault_app_secret_id and set
# VAULT_SECRET_ID_FILE — or paste it directly into VAULT_SECRET_ID.
VAULT_SECRET_ID=<from "vault write -f auth/approle/role/eventnu/secret-id">
#VAULT_SECRET_ID_FILE=/run/secrets/vault_app_secret_id

# --- Secrets now in Vault (record secret/eventnu) ---------------------
# Rotate them with `vault kv put secret/eventnu <key>=<value>` per the
# runbook. Set one here only as a deliberate override, e.g. to debug a
# service without restructuring the record.
#DATABASE_URL=postgres://app_user:<password>@<your-neon-host>/<db>?sslmode=require
#DATABASE_ADMIN_URL=postgres://<owner>:<password>@<your-neon-host>/<db>?sslmode=require
#JWT_SECRET=<openssl rand -hex 32>
#TICKET_QR_SECRET=<openssl rand -hex 32>
#BREVO_API_KEY=<xkeysib-...>
#CHAPA_SECRET_KEY=<...>
#CHAPA_WEBHOOK_SECRET=<...>
#MEDIA_S3_ACCESS_KEY=<...>
#MEDIA_S3_SECRET_KEY=<...>
#FCM_SERVICE_ACCOUNT=<json body>
#FCM_PROJECT_ID=<id>
# NOTE: DATABASE_ADMIN_URL is still required in the environment when the
# ops `migrate` profile runs (goose is a raw binary and does not read
# Vault); the runbook injects it per run from the operator terminal.

# --- Public email delivery -------------------------------------------
# For launch we test with noop (verification links won't send). Real email:
# check sender setup in the top-level README.
EMAIL_PROVIDER=noop
# BREVO_API_SENDER lives in Vault only if the app reads it as a secret;
# it is non-secret: keep it here when enabling Brevo.
#BREVO_API_SENDER=no-reply@<your-domain>

# --- Ops-only loopback port (optional) --------------------------------
# Deploy publishes the API on host loopback for smoke tests; default 8080.
# Set OPS_PORT when the host already serves something there.
#OPS_PORT=18080

# --- Payments / push ---------------------------------------------------
PAYMENT_PROVIDER=noop
PUSH_PROVIDER=noop

# --- Media -------------------------------------------------------------
MEDIA_STORAGE_PROVIDER=local
MEDIA_LOCAL_DIR=/app/media-store
# Only meaningful on API container (uploads are local); run-book mount.
# MEDIA_MAX_UPLOAD_BYTES=<bytes>

# --- CORS public app origins ------------------------------------------
CORS_ALLOWED_ORIGINS=https://<app-origin>   # comma lista if multiple

# --- Analytics ingest / public rate limits -----------------------------
# Defaults documented in README Configuration table.
